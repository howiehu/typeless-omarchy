#!/usr/bin/python
"""Opt-in, reversible desktop integration; --repair migrates existing setups."""
import base64
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import time

home = Path.home()
data = Path(os.environ.get("XDG_DATA_HOME", home / ".local/share"))
state = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state")) / "typeless-omarchy/package.json"
config = home / ".config/hypr/hyprland.lua"
desktop = data / "applications/typeless-omarchy.desktop"
legacy = data / "applications/typeless.desktop"
autostart = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config")) / "autostart/typeless.desktop"
include = '\n-- typeless-omarchy begin\ndofile("/usr/share/typeless-omarchy/typeless.lua")\n-- typeless-omarchy end\n'


def snapshot(path):
    return base64.b64encode(path.read_bytes()).decode() if path.exists() else None


def restore(path, previous):
    if previous is None:
        path.unlink(missing_ok=True)
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(base64.b64decode(previous))


def autostart_command(text):
    lines = [line for line in text.splitlines() if line.startswith("Exec=")]
    if len(lines) != 1:
        return
    line = lines[0]
    try:
        args = shlex.split(line[5:])
    except ValueError:
        return
    prefix = ["env", "TYPELESS_SKIP_SECRET_STORE=1"]
    if args[:2] != prefix or len(args) != 5 or args[3:] != [
            "--system-startup-silent-launch", "--password-store=basic"]:
        return
    executable = Path(args[2])
    runtime_root = Path(os.environ.get("XDG_CACHE_HOME", home / ".cache")) / "typeless-omarchy/runtime"
    if str(executable) not in ("/usr/bin/typeless", "/opt/Typeless/typeless", "/usr/bin/typeless-omarchy") and not (
            executable.name == "typeless" and executable.parent.parent == runtime_root):
        return
    return line, args[2]


def repair_autostart(record):
    # Do not enable autostart or touch unrelated/user-edited commands. The runtime
    # patch keeps future vendor writes on this same filename and preserves Hidden.
    if not autostart.exists():
        return
    text = autostart.read_text()
    command = autostart_command(text)
    if not command:
        return
    line, _ = command
    record.setdefault("autostart_before", snapshot(autostart))
    fixed = text.replace(line, 'Exec=env TYPELESS_SKIP_SECRET_STORE=1 /usr/bin/typeless-omarchy '
                         '--system-startup-silent-launch --password-store=basic', 1)
    record["autostart_installed"] = fixed
    autostart.write_text(fixed)


def install_menu(record, text):
    if desktop.exists() and desktop.read_text() != record.get("menu_installed", text):
        raise SystemExit("Compatibility menu entry changed; reconcile it before repair")
    previous_managed = record.get("replacement_installed", record.get("desktop_installed"))
    if previous_managed and legacy.exists() and legacy.read_text() != previous_managed:
        raise SystemExit("Legacy desktop entry changed; reconcile it before repair")
    # Reuse the official desktop ID so menu and typeless:// resolve to one entry.
    # Retain the original v1 backup instead of backing up our own managed override.
    record.setdefault("replacement_before", record.get("desktop_before", snapshot(legacy)))
    record["replacement_installed"] = text.rstrip('\n') + '\nX-Typeless-Omarchy-Managed=true\n'
    legacy.parent.mkdir(parents=True, exist_ok=True)
    legacy.write_text(record["replacement_installed"])
    # Remove only the managed 0.4.4/manual duplicate; preserve its rollback record.
    if desktop.exists():
        desktop.unlink()
    repair_autostart(record)


def remove_integration(record):
    # Check both entries before changing either, preserving subsequent user edits.
    if desktop.exists() and "menu_installed" in record and desktop.read_text() != record["menu_installed"]:
        raise SystemExit("Compatibility menu entry changed since setup; reconcile it before removal")
    expected_legacy = record.get("replacement_installed", record.get("desktop_installed"))
    if expected_legacy and legacy.exists() and legacy.read_text() != expected_legacy:
        raise SystemExit("Legacy desktop entry changed since setup; reconcile it before removal")
    if "menu_installed" in record:
        restore(desktop, record["menu_before"])
    if "replacement_installed" in record:
        restore(legacy, record["replacement_before"])
    elif "desktop_installed" in record:
        restore(legacy, record["desktop_before"])
    # Preserve vendor/user startup toggles even if the vendor rewrote whitespace.
    # Also handle an autostart first created by the vendor after initial setup.
    if autostart.exists():
        text = autostart.read_text()
        command = autostart_command(text)
        if command and command[1] == "/usr/bin/typeless-omarchy":
            if text == record.get("autostart_installed"):
                restore(autostart, record["autostart_before"])
            else:
                autostart.write_text(text.replace(command[0], command[0].replace(
                    "/usr/bin/typeless-omarchy", "/opt/Typeless/typeless", 1), 1))


def call(method):
    text = subprocess.check_output(["busctl", "--user", "--json=short", "call", "org.fcitx.Fcitx5",
        "/controller", "org.fcitx.Fcitx.Controller1", method], text=True).strip()
    return json.loads(text)["data"] if text else None


def restart_input_method(previous):
    subprocess.run(["omarchy", "restart", "xcompose"], check=True)
    for _ in range(50):
        if subprocess.run(["fcitx5-remote", "--check"], stdout=subprocess.DEVNULL).returncode == 0:
            break
        time.sleep(0.1)
    if previous and previous != "typeless-voice":
        subprocess.run(["fcitx5-remote", "-s", previous], check=True)


def main():
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1] not in ("--remove", "--repair")):
        raise SystemExit("Usage: typeless-omarchy-setup [--repair|--remove]")
    remove = "--remove" in sys.argv
    repair = "--repair" in sys.argv
    existing = state.exists()
    if remove or repair:
        if not existing:
            raise SystemExit("No compatibility setup exists; run typeless-omarchy-setup first")
        record = json.loads(state.read_text())
    else:
        if existing:
            raise SystemExit("Compatibility setup already exists; use --repair to migrate/repair it")
        if (state.parent / "install.json").exists():
            raise SystemExit("Remove the development prototype before packaged setup")
        record = {}
    if not config.exists() or not Path("/usr/lib/fcitx5/typeless-voice.so").exists():
        raise SystemExit("Install the compatibility package in an Omarchy session first")
    previous = call("CurrentInputMethod")[0] if not repair else None
    if remove:
        remove_integration(record)
        config.write_text(config.read_text().replace(include, ""))
        state.unlink()
    else:
        text = Path("/usr/share/applications/typeless.desktop").read_text().replace(
            "Exec=/opt/Typeless/typeless", "Exec=/usr/bin/typeless-omarchy")
        if "Exec=/usr/bin/typeless-omarchy" not in text:
            raise SystemExit("Unsupported vendor desktop entry; compatibility setup was not changed")
        install_menu(record, text)
        state.parent.mkdir(parents=True, exist_ok=True)
        state.write_text(json.dumps(record))
        if include not in config.read_text():
            config.write_text(config.read_text() + include)
    # Repair only launch integration; do not interrupt the working input method.
    if not repair:
        restart_input_method(previous)
    subprocess.run(["update-desktop-database", str(desktop.parent)], check=True)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["hyprctl", "reload"], check=True)
    errors = subprocess.check_output(["hyprctl", "configerrors"], text=True).strip()
    if errors:
        raise SystemExit(errors)
    print("Typeless-Omarchy disabled" if remove else "Typeless-Omarchy enabled; launch Typeless from the application menu")


if __name__ == "__main__":
    main()
